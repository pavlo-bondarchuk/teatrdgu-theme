            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "default_value": "Історія Театру ДГУ триває. Ми збираємо архівні записи в Цифровому музеї та працюємо над новими виставами. Ваша підтримка допомагає зберігати історію театру й дає йому можливість створювати нові роботи.\n\nВнески на підтримку театру збирає наш партнер — Міжнародний благодійний фонд «Культурна столиця». Дякуємо всім, хто підтримує театр в Україні й за кордоном.",
            "rows": 6,
            "new_lines": "",
            "maxlength": "",
            "placeholder": ""
        },
